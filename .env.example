# Copy this file to `.env` and fill it in:  cp .env.example .env
# Modal loads `.env` at deploy time (Secret.from_dotenv), so both deployments
# share this one file. `.env` is gitignored — never commit real credentials.

# ── Competition credentials, one pair per baseline submission ──
# From each submission's Credentials tab in the portal.
EM_API_KEY_GPT5NANO=
EM_WEBHOOK_SECRET_GPT5NANO=whsec_
EM_API_KEY_GEMINI=
EM_WEBHOOK_SECRET_GEMINI=whsec_

# ── Model provider keys ──
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional ── sensible default; uncomment only to override ──
# EM_API_BASE_URL=https://api-beta.explainingmarkets.ai/v1
